# Copy this file to .env and adjust if needed. Everything here is local-only.

# --- PostgreSQL (docker-compose.yml reads these) ---
POSTGRES_USER=aika
POSTGRES_PASSWORD=aika_dev_password
POSTGRES_DB=aika
POSTGRES_PORT=5433

# --- Prisma ---
DATABASE_URL="postgresql://aika:aika_dev_password@localhost:5433/aika?schema=public"

# --- Auth ---
# Signs session JWTs. Must be at least 32 characters. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
JWT_SECRET=""

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL="http://localhost:11434"
# Any model already in Ollama works, e.g. qwen2.5:7b, llama3.2:3b or mistral:7b.
OLLAMA_MODEL="qwen2.5:3b"

# --- Local embeddings (@huggingface/transformers) ---
# Changing the model changes the vector size; the Embedding.vector column is vector(384).
EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2"
EMBEDDING_DIMENSIONS=384
# Model files are downloaded here on first use (about 90 MB), then reused.
EMBEDDING_CACHE_DIR="./.cache/models"
# Set to true after the first run to forbid any network access by the model loader.
EMBEDDING_OFFLINE=false

# --- Retrieval ---
# Chunks retrieved per question, and the cosine similarity below which a chunk
# is considered irrelevant.
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.3

# --- File storage ---
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=20
# Total storage allowed per user, shown on the dashboard.
STORAGE_QUOTA_MB=500
