# Copy this file to .env and adjust if needed. Everything here is local-only.

# --- PostgreSQL (docker-compose.yml reads these) ---
POSTGRES_USER=aika
POSTGRES_PASSWORD=aika_dev_password
POSTGRES_DB=aika
POSTGRES_PORT=5433

# --- Prisma ---
DATABASE_URL="postgresql://aika:aika_dev_password@localhost:5433/aika?schema=public"

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL="http://localhost:11434"
# Switch to e.g. qwen2.5:7b or mistral:7b after `ollama pull <model>`.
OLLAMA_MODEL="llama3.2:3b"

# --- Local embeddings (@huggingface/transformers) ---
# Changing the model changes the vector size; the Embedding.vector column is vector(384).
EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2"
EMBEDDING_DIMENSIONS=384

# --- File storage ---
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=20
